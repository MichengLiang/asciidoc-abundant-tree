    aat:name "2-8C温控规则";
    aat:raw """[.policy, minTemperature=2C, maxTemperature=8C, allowedExcursion=15分钟]
== 2-8C温控规则
超出允许偏离时触发 xref:温度偏离处置流程[rel=triggers, condition=超温超过15分钟]。

""";
    aat:relativePath "samples/business-kg-js-demo/fixtures/cold-chain-operations-attrlist.adoc";
    aat:role "policy";
    aat:startLine 6;
    field:allowedExcursion "15分钟";
    field:maxTemperature "8C";
    field:minTemperature "2C";
    rel:triggers <#温度偏离处置流程>.
