<#约束规则> a aat:Heading;
    aat:addressLabel "required-rule", "rule-query-example";
    aat:childOrder 2;
    aat:containsDirectly <#生成标签节点>;
    aat:contentEndLine 24;
    aat:contentStartLine 11;
    aat:documentOrder 3;
    aat:endLine 25;
    aat:headingLevel 1;
    aat:headingLine 9;
    aat:headline "约束规则";
    aat:metadataEndLine 8;
    aat:metadataStartLine 8;
    aat:name "约束规则";
    aat:raw """[#required-rule.rule, status=active]
== 约束规则

priority:: normal
summary::
约束规则集中说明结构示例必须满足的条件。
多行说明保留为同一个标题字段。

约束规则当前处于 hmeta:review-state[ready, label=可复核]。

[#rule-query-example]
[source,sql]
----
SELECT subject, predicate, object
FROM projected_graph
WHERE role = 'rule';
----

""";
    aat:relativePath "docs/bookshelf/books/12-asciidoc-abundant-tree-guide/cases/010-basic-rdf-projection/source/basic-projection.adoc";
    aat:role "rule";
    aat:startLine 8;
    field:priority "normal";
    field:review-state "ready";
    field:status "active";
    field:summary "约束规则集中说明结构示例必须满足的条件。\n多行说明保留为同一个标题字段。".
