@prefix k8s: <https://micheng.dev/ns/k8s-graph#>.
@prefix rel: <https://micheng.dev/ns/asciidoc-relation#>.

<urn:case:k8s#orders-service> a k8s:Service;
  k8s:name "orders-service";
  rel:depends-on <urn:case:k8s#orders-db>;
  rel:routes-to <urn:case:k8s#public-ingress>.

<urn:case:k8s#orders-db> a k8s:Database;
  k8s:name "orders-db".

<urn:case:k8s#public-ingress> a k8s:Ingress;
  k8s:name "public-ingress".
