@prefix story: <https://micheng.dev/ns/narrative#>.
@prefix rel: <https://micheng.dev/ns/asciidoc-relation#>.

<urn:case:narrative#雨夜车站> a story:Scene;
  story:name "雨夜车站";
  rel:features <urn:case:narrative#林澈>;
  rel:unlocks <urn:case:narrative#寻找车票>.

<urn:case:narrative#寻找车票> a story:Quest;
  story:name "寻找车票";
  rel:requires <urn:case:narrative#旧车票>.
