			"object": {
				"@type": "rdf12:LiteralTerm",
				"@value": "[#required-rule.rule, status=active]\n== 约束规则\n\npriority:: normal\nsummary::\n约束规则集中说明结构示例必须满足的条件。\n多行说明保留为同一个标题字段。\n\n约束规则当前处于 hmeta:review-state[ready, label=可复核]。\n\n[#rule-query-example]\n[source,sql]\n----\nSELECT subject, predicate, object\nFROM projected_graph\nWHERE role = 'rule';\n----\n\n",
				"datatype": {
					"@id": "http://www.w3.org/2001/XMLSchema#string",
					"@type": "rdf12:IriTerm"
				}
			}
		},
